/* ============================================================================
   ПРОЕКТ: BI-система мониторинга эксплуатационной надежности (МЭЗ)
   ФАЙЛ: dax/dax_measures.dax
   ОПИСАНИЕ: Реестр мер DAX и вычисляемых столбцов
   ============================================================================ */


// ============================================================================
// 1. БАЗОВЫЕ КОЛИЧЕСТВЕННЫЕ МЕРЫ (ОБЪЕМЫ И ФАКТ)
// ============================================================================

// Плановое количество приборов к поверке
Плановое_количество = 
COUNTROWS('Приборы')

// Фактическое количество поверенных приборов
Факт_количество = 
COUNTROWS('Выполнение')

// Количество зарегистрированных инцидентов и поломок (с учетом связи с Календарем)
Колич_нарушений = 
CALCULATE(
    COUNTROWS('Нарушения'), 
    USERELATIONSHIP('Календарь'[Date], 'Нарушения'[Дата_обнаружения])
)


// ============================================================================
// 2. ФИНАНСОВЫЕ МЕРЫ И ОЦЕНКА ЗАТРАТ (OpEx)
// ============================================================================

// Плановая стоимость поверочных работ
Плановая_стоимость = 
SUMX(
    'Приборы', 
    RELATED('Прайс'[Цена_поверки_руб.])
)

// Фактическая стоимость выполненных поверок (через связи моделей)
Факт_стоимость = 
SUMX(
    'Выполнение', 
    RELATED('Прайс'[Цена_поверки_руб.])
)

// Доля затрат конкретного цеха от общих расходов предприятия
Доля_затрат = 
DIVIDE(
    [Факт_стоимость], 
    CALCULATE([Факт_стоимость], ALL('Цеха'[Цех]))
)


// ============================================================================
// 3. МЕРЫ ЭФФЕКТИВНОСТИ И ИСПОЛНЕНИЯ ПЛАНА (KPI & COMPLIANCE)
// ============================================================================

// Процент выполнения годового плана поверок
Процент_выполнения = 
DIVIDE(
    [Факт_количество], 
    [Плановое_количество],
    0
)

// Процент брака (доля СИ, признанных непригодными при поверке)
Процент_брака = 
DIVIDE(
    CALCULATE(
        COUNTROWS('Выполнение'), 
        'Выполнение'[Результат] = "Не годен"
    ), 
    [Факт_количество],
    0
)

// Уровень утилизации выделенного OpEx-бюджета
Утилизация_Бюджета_% = 
DIVIDE(
    [Факт_стоимость], 
    [Плановая_стоимость], 
    0
)

// Текстовый индикатор статуса выполнения плана (для KPI-карточек)
Сигнал_KPI = 
IF(
    [Процент_выполнения] >= 0.95, 
    "✅ План в норме", 
    "❌ Срочно догнать план!"
)


// ============================================================================
// 4. НАДЕЖНОСТЬ И ТЕХНИЧЕСКОЕ СОСТОЯНИЕ (MTBF)
// ============================================================================

// Средняя наработка на отказ (Mean Time Between Failures)
MTBF_Прибора = 
AVERAGE('Нарушения'[Интервал_до_отказа])


/* ============================================================================
   5. ВЫЧИСЛЯЕМЫЕ СТОЛБЦЫ (CALCULATED COLUMNS)
   ============================================================================ */

// Таблица: 'Нарушения'
// Столбец: [Интервал_до_отказа]
// Описание: Вычисляет чистые дни между предыдущим обслуживанием/аварией и текущей поломкой

Интервал_до_отказа = 
VAR CurrentAsset = [Заводской_номер]
VAR CurrentFailDate = [Дата_обнаружения]

-- 1. Берем дату базовой поверки прибора из таблицы Приборы
VAR LastPoverka = RELATED('Приборы'[Дата_последней_поверки])

-- 2. Ищем, была ли более ранняя поломка у этого же прибора
VAR PrevFailure = 
    CALCULATE(
        MAX('Нарушения'[Дата_обнаружения]),
        FILTER(
            ALLEXCEPT('Нарушения', 'Нарушения'[Заводской_номер]),
            'Нарушения'[Дата_обнаружения] < CurrentFailDate
        )
    )
    
-- 3. Выбираем самое свежее событие перед текущей аварией
VAR LastEventDate = IF(ISBLANK(PrevFailure), LastPoverka, PrevFailure)

RETURN 
DATEDIFF(LastEventDate, CurrentFailDate, DAY)